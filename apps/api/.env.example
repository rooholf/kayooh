# kayooh API env template. Copy to `.env` (gitignored) and fill in.
# Secrets never live in the repo (FR-SEC-01.4).

# Voucher signing key (Ed25519, FR-SEC-01.1/01.4).
# Generate a pair with: node apps/api/scripts/voucher-keygen.mjs [kid]
# The printed public JWKS entry goes into apps/staff/src/lib/voucher-jwks.json.
VOUCHER_KID=k1
VOUCHER_ED25519_SECRET_KEY=

# Bike-tag HMAC pre-check keys (FR-SEC-01.3, staff app build-time env):
# VITE_TAG_HMAC_KID=k1
# VITE_TAG_HMAC_SECRET=
# VITE_TAG_HMAC_REVOKED_KEYS=
