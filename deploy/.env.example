# Copy to deploy/.env and fill in. Never commit .env.
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
STAFF_DOMAIN=staff.yourdomain.com

# Postgres password for the docker postgres container.
POSTGRES_PASSWORD=change-me-strong

# API secrets (required in production).
BETTER_AUTH_SECRET=generate-32-plus-random-chars
PAYMENT_WEBHOOK_SECRET=from-your-xendit-dashboard
VOUCHER_KID=k1
VOUCHER_ED25519_SECRET_KEY=generate-with-node-apps-api-scripts-voucher-keygen.mjs

# Tag HMAC (staff offline pre-check) — optional; defaults are dev-only.
TAG_HMAC_SECRET=
TAG_HMAC_KID=k1

# Optional: object storage base URL for photo key HEAD checks.
# STORAGE_BASE_URL=https://your-bucket.example.com

# Optional: log level.
LOG_LEVEL=info