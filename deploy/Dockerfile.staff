# Kayooh staff PWA (static, served by nginx).
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/staff ./apps/staff
RUN pnpm install --frozen-lockfile
ARG VITE_API_BASE=https://api.example.com/api/v1
ENV VITE_API_BASE=${VITE_API_BASE}
ARG VITE_TAG_HMAC_KID=k1
ENV VITE_TAG_HMAC_KID=${VITE_TAG_HMAC_KID}
ARG VITE_TAG_HMAC_SECRET=dev-insecure-tag-hmac-secret
ENV VITE_TAG_HMAC_SECRET=${VITE_TAG_HMAC_SECRET}
RUN pnpm --filter @repo/staff build

FROM nginx:1.27-alpine AS runner
COPY --from=builder /app/apps/staff/dist /usr/share/nginx/html
COPY deploy/nginx-staff.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]