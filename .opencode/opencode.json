{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/crw/glm-5.3-flash:free",
  "provider": {
    "crowllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CrowLLM",
      "options": {
        "baseURL": "https://crowllm.com/v1",
        "apiKey": "{env:CROWLLM_API_KEY}"
      },
      "models": {
        "glm-5.3-flash:free": { "name": "glm-5.3-flash:free" }
      }
    },
    "agnes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agnes",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}"
      },
      "models": {
        "agnes-3.0-flash": { "name": "agnes-3.0-flash" }
      }
    }
  },
  "agents": {
    "architect": { "mode": "all" },
    "backend": { "mode": "all" },
    "web-frontend": { "mode": "all" },
    "pwa-engineer": { "mode": "all" },
    "qa": { "mode": "all" },
    "tpm": { "mode": "all" },
    "ui-ux": { "mode": "all" }
  }
}
